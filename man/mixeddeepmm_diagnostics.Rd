\name{mixeddeepmm_diagnostics}
\alias{mixeddeepmm_diagnostics}
\title{Inspect numerical diagnostics from deep mixture fitting}
\description{Summarise Monte Carlo error, log-likelihood trace, starts and iteration counts. The result omits an end-of-run convergence flag.}
\usage{mixeddeepmm_diagnostics(object)}
\arguments{\item{object}{A fitted \code{mixeddeepmm} object.}}
\value{List of fitting and Monte Carlo precision diagnostics.}
